# Supabase connection for local development.
#
# Copy this file to ".env" and paste your project's values (Supabase dashboard →
# Project Settings → API). The ".env" file is git-ignored, so your keys stay
# private. For the deployed site, set these same two values as GitHub Actions
# secrets instead (see .github/workflows/deploy.yml and SETUP.md).
#
# The anon key is meant to be used in the browser — your data is protected by
# Row Level Security in the database, not by hiding this key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
